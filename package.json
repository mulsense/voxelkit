{
  "name": "@mulsense/voxelkit",
  "version": "0.1.2",
  "description": "A JavaScript/TypeScript library for handling various voxel data formats",
  "main": "dist/voxelkit.js",
  "module": "dist/voxelkit.mjs",
  "types": "dist/voxelkit.d.ts",
  "exports": {
    ".": {
      "types": "./dist/voxelkit.d.ts",
      "import": "./dist/voxelkit.mjs",
      "require": "./dist/voxelkit.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "jest",
    "build": "npx rollup --config rollup.config.js --bundleConfigAsCjs",
    "dev": "npx rollup --config rollup.config.js --watch --bundleConfigAsCjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mulsense/voxelkit.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mulsense/voxelkit/issues"
  },
  "homepage": "https://github.com/mulsense/voxelkit#readme",
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.2",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "onchange": "^7.1.0",
    "rollup": "^4.53.3",
    "rollup-plugin-dts": "^6.3.0",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
